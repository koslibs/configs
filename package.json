{
    "name": "@koslibs/configs",
    "version": "0.2.7",
    "description": "Tool for api usage within react app",
    "main": "./index.js",
    "private": false,
    "license": "MIT",
    "author": "holypower777",
    "type": "module",
    "files": [
        "cli",
        "commitlint",
        "eslint",
        "playwright",
        "prettier",
        "shared",
        "tsconfig",
        "vite",
        "index.js",
        "eslint.config.mjs",
        "LICENSE"
    ],
    "bin": {
        "koslibs-lint": "cli/lint.js"
    },
    "scripts": {
        "lint": "npm run lint:js && npm run format:check",
        "lint:fix": "npm run lint:js --fix && npm run format",
        "lint:js": "node ./cli/lint.js js",
        "format": "node ./cli/lint.js format",
        "format:check": "node ./cli/lint.js format:check",
        "release": "changeset publish",
        "release:snapshot": "changeset publish --tag snapshot --no-git-tag",
        "version-package": "changeset version",
        "version-package:patch": "npm version patch --no-git-tag-version",
        "version-package:snapshot": "changeset version --snapshot snapshot"
    },
    "bugs": {
        "url": "https://github.com/koslibs/configs/issues"
    },
    "homepage": "https://github.com/koslibs/configs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/koslibs/configs.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=22.14.0"
    },
    "prettier": "./prettier",
    "commitlint": {
        "extends": "./commitlint"
    },
    "exports": {
        ".": "./index.js",
        "./eslint": "./eslint/index.mjs",
        "./eslint/config": "./eslint/config.mjs",
        "./eslint/react": "./eslint/react.mjs",
        "./playwright": "./playwright/index.mjs",
        "./prettier": "./prettier/index.js",
        "./commitlint": "./commitlint/index.js",
        "./tsconfig": "./tsconfig/index.json",
        "./tsconfig/base": "./tsconfig/base.json",
        "./tsconfig/node": "./tsconfig/node.json",
        "./vite": "./vite/index.mjs"
    },
    "dependencies": {
        "@commitlint/cli": "20.3.1",
        "@commitlint/config-conventional": "20.3.1",
        "@eslint/eslintrc": "3.3.1",
        "@eslint/js": "9.36.0",
        "eslint": "9.36.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import-helpers": "2.0.1",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-storybook": "0.11.2",
        "globals": "16.4.0",
        "lefthook": "2.0.13",
        "prettier": "3.6.2",
        "typescript": "5.7.2",
        "typescript-eslint": "8.44.0"
    },
    "devDependencies": {
        "@changesets/changelog-github": "^0.5.2",
        "@changesets/cli": "^2.29.8",
        "@types/node": "^24.4.0"
    }
}

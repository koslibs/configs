{
    "name": "@koslibs/configs",
    "version": "1.0.1",
    "description": "Tool for api usage within react app",
    "main": "./index.js",
    "private": false,
    "license": "MIT",
    "author": "holypower777",
    "type": "module",
    "files": [
        "cli",
        "commitlint",
        "eslint",
        "playwright",
        "prettier",
        "rstest",
        "shared",
        "tsconfig",
        "vite",
        "index.js",
        "eslint.config.mjs",
        "LICENSE",
        "release",
        "lefthook",
        "README.md"
    ],
    "bin": {
        "koslibs-lint": "cli/lint.js",
        "koslibs-release": "cli/release.js"
    },
    "scripts": {
        "lint": "node ./cli/lint.js lint",
        "lint:fix": "node ./cli/lint.js lint:fix",
        "lint:js": "node ./cli/lint.js js",
        "lint:js:fix": "node ./cli/lint.js js --fix",
        "format": "node ./cli/lint.js format",
        "format:check": "node ./cli/lint.js format:check",
        "release": "node ./cli/release.js publish",
        "release:snapshot": "node ./cli/release.js publish --tag snapshot --no-git-tag",
        "version-package": "node ./cli/release.js version",
        "version-package:snapshot": "node ./cli/release.js version --snapshot snapshot",
        "changeset": "node ./cli/release.js add",
        "changeset:check": "node ./cli/release.js check",
        "prepare": "node ./cli/release.js hooks:install",
        "test": "node --test tests/*.test.mjs"
    },
    "bugs": {
        "url": "https://github.com/koslibs/configs/issues"
    },
    "homepage": "https://github.com/koslibs/configs",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/koslibs/configs.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=24.13.0"
    },
    "prettier": "./prettier",
    "commitlint": {
        "extends": "./commitlint"
    },
    "exports": {
        ".": "./index.js",
        "./eslint": "./eslint/index.mjs",
        "./eslint/config": "./eslint/config.mjs",
        "./eslint/react": "./eslint/react.mjs",
        "./playwright": "./playwright/index.mjs",
        "./prettier": "./prettier/index.js",
        "./rstest": {
            "types": "./rstest/index.d.ts",
            "default": "./rstest/index.mjs"
        },
        "./rstest/react": {
            "types": "./rstest/react.d.ts",
            "default": "./rstest/react.mjs"
        },
        "./commitlint": "./commitlint/index.js",
        "./tsconfig": "./tsconfig/index.json",
        "./tsconfig/base": "./tsconfig/base.json",
        "./tsconfig/node": "./tsconfig/node.json",
        "./vite": "./vite/index.mjs",
        "./release": "./release/index.mjs",
        "./changelog": "./release/changelog.mjs",
        "./lefthook": "./lefthook/index.yml"
    },
    "dependencies": {
        "@changesets/changelog-github": "0.5.2",
        "@changesets/cli": "3.0.3",
        "@changesets/parse": "0.4.3",
        "@commitlint/cli": "20.3.1",
        "@commitlint/config-conventional": "20.3.1",
        "@eslint/js": "9.36.0",
        "@rsbuild/plugin-react": "2.1.1",
        "@rstest/core": "0.12.2",
        "@typescript-eslint/parser": "8.71.0",
        "eslint": "9.36.0",
        "eslint-config-prettier": "10.1.8",
        "eslint-plugin-import-helpers": "2.0.1",
        "eslint-plugin-prettier": "5.5.4",
        "eslint-plugin-storybook": "0.11.2",
        "globals": "16.4.0",
        "happy-dom": "20.14.5",
        "lefthook": "2.0.13",
        "prettier": "3.6.2",
        "typescript": "5.7.2",
        "typescript-eslint": "8.71.0"
    },
    "devDependencies": {
        "@types/node": "24.10.4"
    }
}
